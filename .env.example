# Database
DATABASE_URL=postgresql+asyncpg://metaseed:metaseed_dev@localhost:7432/metaseed_hub

# Keycloak OIDC
KEYCLOAK_URL=http://localhost:7080
KEYCLOAK_REALM=metaseed
KEYCLOAK_CLIENT_ID=metaseed-hub
KEYCLOAK_CLIENT_SECRET=metaseed-hub-dev-secret

# OIDC scope. SRAM requires eduperson_entitlement to release group memberships
# (used for admin access via ADMIN_ROLE) and offline_access for refresh tokens.
# The application default omits these, so deployments against SRAM must set it.
OIDC_SCOPE=openid email profile eduperson_entitlement offline_access

# Redis
REDIS_URL=redis://localhost:7379/0

# Application
DEBUG=true
CORS_ORIGINS=["http://localhost:7300"]
APP_URL=http://localhost:7001

# Admin access (SRAM entitlement or role name)
ADMIN_ROLE=admin
