[Unit]
Description=Metaseed Hub Auto-Deploy
After=network.target

[Service]
Type=oneshot
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}
ExecStart={{ app_dir }}/deploy.sh
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

# Allow sudo for service restart
Environment="PATH={{ app_dir }}/.local/bin:/usr/local/bin:/usr/bin:/bin"
