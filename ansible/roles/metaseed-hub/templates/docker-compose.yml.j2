services:
  postgres:
    image: postgres:16
    container_name: metaseed-postgres
    restart: always
    environment:
      POSTGRES_USER: {{ db_user }}
      POSTGRES_PASSWORD: {{ db_password }}
      POSTGRES_DB: {{ db_name }}
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ db_user }} -d {{ db_name }}"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: metaseed-redis
    restart: always
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data

  matomo-db:
    image: mariadb:11
    container_name: metaseed-matomo-db
    restart: always
    command: --max-allowed-packet=64MB
    environment:
      MARIADB_DATABASE: matomo
      MARIADB_USER: matomo
      MARIADB_PASSWORD: {{ matomo_db_password }}
      MARIADB_ROOT_PASSWORD: {{ matomo_db_password }}
    volumes:
      - matomo_db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5

  matomo:
    image: matomo:5-apache
    container_name: metaseed-matomo
    restart: always
    depends_on:
      matomo-db:
        condition: service_healthy
    environment:
      MATOMO_DATABASE_HOST: matomo-db
      MATOMO_DATABASE_ADAPTER: mysql
      MATOMO_DATABASE_TABLES_PREFIX: matomo_
      MATOMO_DATABASE_USERNAME: matomo
      MATOMO_DATABASE_PASSWORD: {{ matomo_db_password }}
      MATOMO_DATABASE_DBNAME: matomo
    # Loopback only. The public tracker (matomo.php/js) is served via nginx at
    # /matomo/; the PHP admin UI is reachable only through an SSH tunnel to this
    # port, so it is never exposed to the internet.
    ports:
      - "127.0.0.1:{{ matomo_port }}:80"
    volumes:
      - matomo_data:/var/www/html
      # Merged with the config Matomo owns, so it survives Matomo rewriting
      # its own file. Without it Matomo records the proxy as every visitor.
      - /opt/metaseed-docker/matomo-common.config.ini.php:/var/www/html/config/common.config.ini.php:ro

volumes:
  postgres_data:
  redis_data:
  matomo_db_data:
  matomo_data:
