upstream metaseed_backend {
    server 127.0.0.1:{{ app_port }};
    keepalive 32;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ nginx_server_name }};

    ssl_certificate {{ ssl_certificate }};
    ssl_certificate_key {{ ssl_certificate_key }};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # CSP: htmx and vis-network are now self-hosted (see ui/static/js), so no
    # external script origin is allowed. 'unsafe-inline' remains for the app's
    # inline scripts and event handlers; the other directives constrain
    # object/base/frame-ancestors and block all external origins.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'" always;

    access_log /var/log/nginx/metaseed-access.log;
    error_log /var/log/nginx/metaseed-error.log;

    client_max_body_size 50M;

    location / {
        proxy_pass http://metaseed_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    location /hub/hub-static/ {
        alias {{ app_dir }}/src/metaseed_hub/ui/static/;
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # Matomo analytics: ONLY the two tracker endpoints are public, so the
    # installer and the admin UI are never exposed to the internet. Reach the
    # admin through an SSH tunnel to 127.0.0.1:{{ matomo_port }}. Same-origin, so
    # the CSP (script-src/connect-src 'self') allows the tracker.
    location = /matomo/matomo.php {
        proxy_pass http://127.0.0.1:{{ matomo_port }}/matomo.php;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location = /matomo/matomo.js {
        proxy_pass http://127.0.0.1:{{ matomo_port }}/matomo.js;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The admin / reporting UI is NOT served under this subpath: Matomo does not
    # run cleanly behind a stripped-prefix reverse proxy (it generates
    # root-relative URLs for its dynamic assets, so the logo and login break).
    # View the dashboard through an SSH tunnel to 127.0.0.1:{{ matomo_port }},
    # where Matomo is served at its own root.

}

server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }};
    return 301 https://$server_name$request_uri;
}
