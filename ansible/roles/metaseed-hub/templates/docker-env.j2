# Credentials for docker-compose.yml, which is a static file so Dependabot can
# read its image pins. Compose reads this automatically from the project
# directory; nothing else sources it.
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_NAME={{ db_name }}
MATOMO_DB_PASSWORD={{ matomo_db_password }}
MATOMO_PORT={{ matomo_port }}
