{
  "realm": "metaseed",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "metaseed-hub",
      "name": "Metaseed Hub",
      "enabled": true,
      "publicClient": false,
      "secret": "metaseed-hub-dev-secret",
      "redirectUris": [
        "http://localhost:7001/*",
        "http://localhost:7001/hub/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:7001"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "attributes": {},
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "metaseed-hub",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "eduperson_entitlement",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "eduperson_entitlement",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user"
      },
      {
        "name": "admin",
        "description": "Administrator"
      }
    ]
  },
  "users": [
    {
      "username": "demo",
      "email": "demo@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "groups": [
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:seek",
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:ena",
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:pride",
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:brapi",
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:metabolights",
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:dcat",
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:beta-testers"
      ]
    },
    {
      "username": "admin",
      "email": "admin@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ],
      "groups": [
        "/urn:mace:surf.nl:sram:group:tudelft:metaseed:admin"
      ]
    }
  ],
  "groups": [
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:seek",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:seek"
    },
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:ena",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:ena"
    },
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:pride",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:pride"
    },
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:brapi",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:brapi"
    },
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:metabolights",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:metabolights"
    },
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:dcat",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:dcat"
    },
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:beta-testers",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:beta-testers"
    },
    {
      "name": "urn:mace:surf.nl:sram:group:tudelft:metaseed:admin",
      "path": "/urn:mace:surf.nl:sram:group:tudelft:metaseed:admin"
    }
  ]
}
